{
  "name": "dsh-rabiroute-agent",
  "version": "0.9.1",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./message-mode": "./lib/message-mode.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "README.md",
    "README_en.md",
    "CHANGELOG.md",
    "CHANGELOG_en.md",
    "tests",
    "presets",
    "cordis.patch.yml",
    "LICENSE",
    "AUTO-VOICE.md"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.0-rc.7",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.7"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vb2250158/dsh-rabiroute-agent.git"
  },
  "homepage": "https://github.com/vb2250158/dsh-rabiroute-agent#readme",
  "bugs": {
    "url": "https://github.com/vb2250158/dsh-rabiroute-agent/issues"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-user-questions",
        "@deepseek-ai/dsh-client-ui-workspace"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "node tests/build.mjs",
    "test": "node tests/build.mjs && node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "jsdom": "^29.1.1"
  }
}
